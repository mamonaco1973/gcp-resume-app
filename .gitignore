# ==============================================================================
# Terraform state and providers
# ==============================================================================
.terraform
*.terraform.*
*.tfstate
*.tfstate.backup
*.tfvars

# ==============================================================================
# Build artifacts
# ==============================================================================
# archive_file in 02-functions/functions.tf zips the source dirs to
# api.zip / worker.zip on every apply.
*.zip

# apply.sh substitutes into js/config.js.tmpl to produce this at deploy time.
# It carries the Firebase API key and the gateway URL, so it is generated,
# never authored.
config.js

# ==============================================================================
# Vendored Python dependencies
# ==============================================================================
# apply.sh does:
#     pip install -r code/api/requirements.txt    -t code/api/    ...
#     pip install -r code/worker/requirements.txt -t code/worker/ ...
#
# That drops every dependency INTO the function source directories, because
# Cloud Functions deploys whatever is in the zip. So after any build these
# folders fill with functions_framework/, google/, vertexai/, bs4/ and a pile
# of *.dist-info/ -- none of which belongs in the repo.
#
# Listing those by name does not hold: the previous version of this file named
# only the beautifulsoup ones AND pinned their versions
# (beautifulsoup4-4.12.3.dist-info/), so a version bump or any other package
# went straight into a commit.
#
# Ignore the directories wholesale and re-admit the two real source files
# instead. Adding a new hand-written module means adding a ! line for it.
02-functions/code/api/*
!02-functions/code/api/main.py
!02-functions/code/api/requirements.txt

02-functions/code/worker/*
!02-functions/code/worker/main.py
!02-functions/code/worker/requirements.txt

# ==============================================================================
# Python bytecode
# ==============================================================================
__pycache__/
*.py[cod]

# ==============================================================================
# Secrets and keys
# ==============================================================================
credentials.json
*.pem
*.pub

# ==============================================================================
# OS noise
# ==============================================================================
.DS_Store
Thumbs.db
